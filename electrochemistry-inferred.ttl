###  https://w3id.org/emmo#MicroGray
ns1:MicroGray rdf:type owl:Class ;
              rdfs:subClassOf ns1:EMMO_1e85f9fa_ded6_4856_81be_ccca3c474314 ,
                              ns1:EMMO_847f1d9f_205e_46c1_8cb6_a9e479421f88 ,
                              ns1:EMMO_9ff3bf8e_2168_406e_8251_1d158fc948ae ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4 ;
                                owl:someValuesFrom ns1:Gray
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                owl:hasValue "1.0E-6"^^xsd:double
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                owl:hasValue "0.0"^^xsd:double
                              ] ;
              rdfs:comment """0.000001 fold of the SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer.

-- QUDT"""@en ;
              rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/prefixedsiunits#> ;
              rdfs:label "MicroGray" ;
              skos:altLabel "MicroGray"@en ;
              skos:prefLabel "MicroGray" ;
              ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/MicroGRAY" ;
              ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "uGy" ;
              ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "µGy" ;
              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """0.000001 fold of the SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer.

-- QUDT"""@en ;
              ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Grey?oldid=494774160" .


