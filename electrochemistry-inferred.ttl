                                                       rdfs:subClassOf :electrochemistry_5f9a9411_05f9_4576_acd3_81d7d41cfe98 ;
                                                       rdfs:comment "An ionic liquid is an electrolyte composed of a salt that is liquid below 100 °C. Ionic liquids have found uses in electrochemical analysis, because their unconventional properties include a negligible vapor pressure, a high thermal and electrochemical stability, and exceptional dissolution properties for both organic and inorganic chemical species."@en ;
                                                       rdfs:isDefinedBy <https://w3id.org/emmo/domain/reference/electrochemistry-reference#> ;
                                                       rdfs:label "IonicLiquidElectrolyte"@en ;
                                                       skos:altLabel "IonicLiquid"@en ;
                                                       skos:prefLabel "IonicLiquidElectrolyte"@en ;
                                                       ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "https://dbpedia.org/page/Ionic_liquid"@en ;
                                                       ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "An ionic liquid is an electrolyte composed of a salt that is liquid below 100 °C. Ionic liquids have found uses in electrochemical analysis, because their unconventional properties include a negligible vapor pressure, a high thermal and electrochemical stability, and exceptional dissolution properties for both organic and inorganic chemical species."@en ;
                                                       ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "https://en.wikipedia.org/wiki/Ionic_liquid"@en .

