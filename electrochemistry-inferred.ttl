                                    ns1:EMMO_ac19c801_bead_4730_8b8c_50020eec45ec ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                      owl:hasValue "60.0"^^xsd:double
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                      owl:hasValue "0.0"^^xsd:double
                                    ] ;
                    rdfs:comment """Radian Per Minute (rad/min) is a unit in the category of Angular velocity. It is also known as radians per minute, radian/minute. Radian Per Minute (rad/min) has a dimension of aT-1 where T is time. It can be converted to the corresponding standard SI unit rad/s by multiplying its value by a factor of 0.0166666666667.

-- QUDT"""@en ;
                    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siacceptedunits#> ,
                                     "http://qudt.org/2.1/vocab/unit" ;
                    rdfs:label "RadianPerMinute"@en ;
                    skos:altLabel "Radian per Minute"@en ;
                    skos:prefLabel "RadianPerMinute"@en ;
                    ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/RAD-PER-MIN" ;
                    ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "rad.min-1" ,
                                                                  "rad/min" ;
                    ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "rad/min" ;
                    ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """Radian Per Minute (rad/min) is a unit in the category of Angular velocity. It is also known as radians per minute, radian/minute. Radian Per Minute (rad/min) has a dimension of aT-1 where T is time. It can be converted to the corresponding standard SI unit rad/s by multiplying its value by a factor of 0.0166666666667.

-- QUDT"""@en .


###  https://w3id.org/emmo#RadianPerSecond
ns1:RadianPerSecond rdf:type owl:Class ;
                    rdfs:subClassOf ns1:EMMO_1273eb34_de48_43a9_925f_104110469dd2 ,
                                    ns1:EMMO_515b5579_d526_4842_9e6f_ecc34db6f368 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                      owl:hasValue "1.0"^^xsd:double
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                      owl:hasValue "0.0"^^xsd:double
                                    ] ;
                    rdfs:comment """\"Radian per Second\" is the SI unit of rotational speed (angular velocity), and, also the unit of angular frequency. The radian per second is defined as the change in the orientation of an object, in radians, every second.

-- QUDT"""@en ;
                    rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/coherentsiunits#> ,
                                     "http://qudt.org/2.1/vocab/unit" ;
                    rdfs:label "RadianPerSecond"@en ;
                    skos:altLabel "radian per second"@en ;
                    skos:prefLabel "RadianPerSecond"@en ;
                    ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/RAD-PER-SEC" ;
                    ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "rad.s-1" ,
                                                                  "rad/s" ;
                    ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "rad/s" ;
                    ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """\"Radian per Second\" is the SI unit of rotational speed (angular velocity), and, also the unit of angular frequency. The radian per second is defined as the change in the orientation of an object, in radians, every second.

-- QUDT"""@en .


