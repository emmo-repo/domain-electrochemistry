###  https://w3id.org/emmo#Farad
ns1:Farad rdf:type owl:Class ;
          rdfs:subClassOf ns1:EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3 ,
                          ns1:EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45 ,
                          ns1:EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a ,
                          ns1:EMMO_b14d9be5_f81e_469b_abca_379c2e83feab ,
                          ns1:EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                            owl:hasValue "F"
                          ] ;
          rdfs:comment "Measurement unit for electric capacitance."@en ,
                       """The SI unit of electric capacitance. Very early in the study of electricity scientists discovered that a pair of conductors separated by an insulator can store a much larger charge than an isolated conductor can store. The better the insulator, the larger the charge that the conductors can hold. This property of a circuit is called capacitance, and it is measured in farads. One farad is defined as the ability to store one coulomb of charge per volt of potential difference between the two conductors. This is a natural definition, but the unit it defines is very large. In practical circuits, capacitance is often measured in microfarads, nanofarads, or sometimes even in picofarads (10⁻¹² farad, or trillionths of a farad). The unit is named for the British physicist Michael Faraday (1791-1867), who was known for his work in electricity and electrochemistry.

-- QUDT"""@en ;
          rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits#> ;
          rdfs:label "Farad"@en ;
          skos:prefLabel "Farad"@en ;
          schema:unitCode "FAR" ;
          ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/FARAD" ;
          ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "F" ;
          ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "http://dbpedia.org/resource/Farad"^^xsd:anyURI ;
          ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """The SI unit of electric capacitance. Very early in the study of electricity scientists discovered that a pair of conductors separated by an insulator can store a much larger charge than an isolated conductor can store. The better the insulator, the larger the charge that the conductors can hold. This property of a circuit is called capacitance, and it is measured in farads. One farad is defined as the ability to store one coulomb of charge per volt of potential difference between the two conductors. This is a natural definition, but the unit it defines is very large. In practical circuits, capacitance is often measured in microfarads, nanofarads, or sometimes even in picofarads (10⁻¹² farad, or trillionths of a farad). The unit is named for the British physicist Michael Faraday (1791-1867), who was known for his work in electricity and electrochemistry.

-- QUDT"""@en ;
          ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Farad?oldid=493070876"^^xsd:anyURI ;
          ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://doi.org/10.1351/goldbook.F02320" .


