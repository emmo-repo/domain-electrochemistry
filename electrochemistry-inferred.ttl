###  https://w3id.org/emmo#MilliArcsecond
ns1:MilliArcsecond rdf:type owl:Class ;
                   rdfs:subClassOf ns1:EMMO_1e85f9fa_ded6_4856_81be_ccca3c474314 ,
                                   ns1:EMMO_a3a701ed_6f7d_4a10_9aee_dfa1961fc7b7 ,
                                   ns1:EMMO_cdc962d8_f3ea_4764_a57a_c7caa4859179 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4 ;
                                     owl:someValuesFrom ns1:Arcsecond
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                     owl:hasValue "4.848137E-9"^^xsd:double
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                     owl:hasValue "0.0"^^xsd:double
                                   ] ;
                   rdfs:comment """A minute of arc, arcminute, or minute arc (MOA), is a unit of angular measurement equal to one sixtieth (1/60) of one degree (circle/21,600), or π /10,800 radians. In turn, a second of arc or arcsecond is one sixtieth (1/60) of one minute of arc. Since one degree is defined as one three hundred and sixtieth (1/360) of a rotation, one minute of arc is 1/21,600 of a rotation.  the milliarcsecond, abbreviated mas, is used in astronomy.

-- QUDT"""@en ;
                   rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siacceptedunits#> ;
                   rdfs:label "MilliArcsecond"@en ;
                   skos:altLabel "Milli ArcSecond"@en ;
                   skos:prefLabel "MilliArcsecond"@en ;
                   ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/MilliARCSEC" ;
                   ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "m''" ;
                   ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "mas" ;
                   ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """A minute of arc, arcminute, or minute arc (MOA), is a unit of angular measurement equal to one sixtieth (1/60) of one degree (circle/21,600), or π /10,800 radians. In turn, a second of arc or arcsecond is one sixtieth (1/60) of one minute of arc. Since one degree is defined as one three hundred and sixtieth (1/360) of a rotation, one minute of arc is 1/21,600 of a rotation.  the milliarcsecond, abbreviated mas, is used in astronomy.

-- QUDT"""@en ;
                   ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Minute_of_arc" .


