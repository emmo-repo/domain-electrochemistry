###  https://w3id.org/emmo#EMMO_15db234d_ecaf_4715_9838_4b4ec424fb13
ns1:EMMO_15db234d_ecaf_4715_9838_4b4ec424fb13 rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_49267eba_5548_4163_8f36_518d65b583f9 ;
                                              rdfs:comment "A class devoted to categorize causal objects by specifying their granularity levels."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/reductionistic#> ;
                                              rdfs:label "Reductionistic"@en ;
                                              skos:prefLabel "Reductionistic"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A class devoted to categorize causal objects by specifying their granularity levels."@en ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f """A granularity level is specified by a tiling decomposition of the whole y. A tiling is identified as a set of items {x1, x2, ... xn} called tiles that:
    - are proper parts of y
    - covers the entire whole (y = x1 +x2 + ... + xn)
    - do not overlap
    - are part of one, and one only, whole (inverse functional)"""@en ,
                                                                                            "Direct parthood is the antitransitive parthood relation used to build the class hierarchy (and the granularity hierarchy) for this perspective."@en .


