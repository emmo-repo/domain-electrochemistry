###  https://w3id.org/emmo/domain/chemical-substance#substance_3032a52b_72ee_4f3f_95d7_5011e0967e85
ns2:substance_3032a52b_72ee_4f3f_95d7_5011e0967e85 rdf:type owl:Class ;
                                                   rdfs:subClassOf ns2:substance_dc68514f_b592_4e1b_a00f_fbb29f2fafbd ;
                                                   rdfs:comment "A polysulfone-based polymer functionalized with quaternary ammonium groups, used as an anion-conducting membrane material in electrochemical applications."@en ;
                                                   rdfs:isDefinedBy ns2: ;
                                                   rdfs:label "QuaternaryAmmoniumPolySulfone"@en ;
                                                   skos:note "Quaternary ammonium polysulfones are a class of anion exchange polymers where quaternary ammonium functional groups are grafted onto a polysulfone backbone, enabling ionic conductivity in alkaline electrochemical systems. They are structurally distinct from other ion-conducting polymers such as imidazolium-functionalized or piperidinium-based materials due to their sulfone-containing aromatic backbone. Including this term supports precise semantic classification of anion exchange membrane materials in energy and polymer ontologies."@en ,
                                                             "Quaternary ammonium polysulfones are widely used in anion exchange membranes for fuel cells, electrolyzers, and related alkaline electrochemical devices."@en ;
                                                   skos:prefLabel "QuaternaryAmmoniumPolySulfone"@en ;
                                                   ns1:EMMO_4c8480cf_56de_41da_8699_f12a9033313a "Quaternary ammonium polysulfones are chemically and functionally distinct from piperidinium- and imidazolium-functionalized polymers due to differences in cation stability and hydroxide conductivity behavior."@en ;
                                                   ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A polysulfone-based polymer functionalized with quaternary ammonium groups, used as an anion-conducting membrane material in electrochemical applications."@en .


