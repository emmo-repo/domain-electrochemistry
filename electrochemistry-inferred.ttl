###  https://w3id.org/emmo#EMMO_17b031fb_4695_49b6_bb69_189ec63df3ee
ns1:EMMO_17b031fb_4695_49b6_bb69_189ec63df3ee rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_4f2d3939_91b1_4001_b8ab_7d19074bf845 ;
                                              rdfs:comment "Correspond to the work needed per unit of charge to move a test charge between two points in a static electric field."@en ,
                                                           "The difference in electric potential between two points."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#> ;
                                              rdfs:label "Voltage"@en ;
                                              skos:altLabel "ElectricPotentialDifference"@en ,
                                                            "ElectricTension"@en ;
                                              skos:prefLabel "Voltage"@en ;
                                              skos:scopeNote "Voltage represents the difference in electric potential between two points in an electric circuit. In electrochemistry, it refers to the potential difference between the electrodes of a battery or electrochemical cell. Voltage influences the driving force of redox reactions and determines energy output in batteries, fuel cells, and electrolysis processes. It is commonly measured in volts (V)."@en ;
                                              ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/quantitykind/Voltage"@en ;
                                              ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 "6-11.3" ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The difference in electric potential between two points."@en ;
                                              ns1:EMMO_b6730304_cabc_4104_b415_14218466445c "Voltage is often used interchangeably with electric potential, but technically, voltage refers to a potential difference between two points."@en ;
                                              ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://doi.org/10.1351/goldbook.V06635"@en ,
                                                                                            "https://doi.org/10.1351/goldbook.A00424" .


