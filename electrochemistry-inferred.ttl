###  https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d3c0078e_c1d3_461e_873d_e5c3adf441c5
:electrochemistry_d3c0078e_c1d3_461e_873d_e5c3adf441c5 rdf:type owl:Class ;
                                                       rdfs:subClassOf :electrochemistry_9b3b4668_0795_4a35_9965_2af383497a26 ;
                                                       rdfs:comment "the minimum acceptable threshold value for the rated capacity of an electrochemical device, as stated by the manufacturer."@en ;
                                                       rdfs:isDefinedBy <https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#> ;
                                                       rdfs:label "MinimumCapacity"@en ;
                                                       rdfs:seeAlso :electrochemistry_8abde9d0_84f6_4b4f_a87e_86028a397100 ,
                                                                    :electrochemistry_a7a4614f_2426_46f3_8475_cda4a9fabfce ,
                                                                    :electrochemistry_b7781ebc_90a7_4f19_997f_aed28dee1b01 ;
                                                       skos:altLabel "MinimumAcceptedCapacity"@en ;
                                                       skos:prefLabel "MinimumCapacity"@en ;
                                                       skos:scopeNote "Manufacturers define the value for 'minimum capacity' as the lower performance limit, ensuring that every device meets a minimum standard. In practice, minimum capacity is often about 95-97% of the nominal capacity, acting as a guaranteed lower bound rather than an exact measurement."@en ;
                                                       ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "the minimum acceptable threshold value for the rated capacity of an electrochemical device, as stated by the manufacturer."@en ;
                                                       ns1:EMMO_b6730304_cabc_4104_b415_14218466445c "For real applications, the achieveable minimum capacity is affected by environmental conditions, rate of operation, and state-of-heath and can deviate from the reported value."@en ;
                                                       ns1:EMMO_cc65321f_1964_4f16_aea3_2a8edf2f3394 ns1:AmpereHour ,
                                                                                                     ns1:MilliAmpereHour .


