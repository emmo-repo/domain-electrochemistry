###  https://w3id.org/emmo#NanoSecond
ns1:NanoSecond rdf:type owl:Class ;
               rdfs:subClassOf ns1:EMMO_02e894c3_b793_4197_b120_3442e08f58d1 ,
                               ns1:EMMO_1e85f9fa_ded6_4856_81be_ccca3c474314 ,
                               ns1:EMMO_e1981c25_7c55_4020_aa7a_d2e14ced86d4 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty ns1:EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4 ;
