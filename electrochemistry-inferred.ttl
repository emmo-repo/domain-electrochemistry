                                              rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/metrology#> ;
                                              rdfs:label "OrdinalQuantity"@en ;
                                              skos:example """Hardness
Resilience"""@en ;
                                              skos:prefLabel "OrdinalQuantity"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """\"Quantity, defined by a conventional measurement procedure, for which a total ordering relation can be established, according to magnitude, with other quantities of the same kind, but for which no algebraic operations among those quantities exist\"
