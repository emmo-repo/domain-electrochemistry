###  https://w3id.org/emmo#Mole
ns1:Mole rdf:type owl:Class ;
         rdfs:subClassOf ns1:EMMO_3a185e6c_9e19_4776_b583_19c978156aa0 ,
                         ns1:EMMO_e501069c_34d3_4dc7_ac87_c90c7342192b ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                           owl:hasValue "mol"
                         ] ;
         rdfs:comment "The mole, symbol mol, is the SI unit of amount of substance. One mole contains exactly 6.022 140 76 × 1023 elementary entities. This number is the fixed numerical value of the Avogadro constant, NA, when expressed in the unit mol−1 and is called the Avogadro number. The amount of substance, symbol n, of a system is a measure of the number of specified elementary entities. An elementary entity may be an atom, a molecule, an ion, an electron, any other particle or specified group of particles."@en ;
         rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits#> ;
         rdfs:label "Mole"@en ;
         skos:prefLabel "Mole"@en ;
         schema:unitCode "C34" ;
         ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/MOL" ;
         ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "mol" ;
         ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "http://dbpedia.org/resource/Mole_%28unit%29"^^xsd:anyURI ;
         ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 "The mole, symbol mol, is the SI unit of amount of substance. One mole contains exactly 6.022 140 76 × 1023 elementary entities. This number is the fixed numerical value of the Avogadro constant, NA, when expressed in the unit mol−1 and is called the Avogadro number. The amount of substance, symbol n, of a system is a measure of the number of specified elementary entities. An elementary entity may be an atom, a molecule, an ion, an electron, any other particle or specified group of particles."@en ;
         ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Mole_(unit)"^^xsd:anyURI ;
         ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://doi.org/10.1351/goldbook.M03980" .


