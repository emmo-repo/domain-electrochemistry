###  https://w3id.org/emmo#SquareMetrePerSecond
ns1:SquareMetrePerSecond rdf:type owl:Class ;
                         rdfs:subClassOf ns1:EMMO_1273eb34_de48_43a9_925f_104110469dd2 ,
                                         ns1:EMMO_b33cc5b5_a9dc_4082_b497_14d1654c5591 ,
