###  https://w3id.org/emmo#EMMO_2553c342_fc28_47d8_8e19_7a98fa08f150
ns1:EMMO_2553c342_fc28_47d8_8e19_7a98fa08f150 rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_9d799b43_e188_4047_8167_121d96b31a26 ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty [ owl:inverseOf ns1:EMMO_7329967c_3972_4c99_b478_84f66436620d
                                                                               ] ;
                                                                owl:someValuesFrom ns1:EMMO_90ae56e4_d197_49b6_be1a_0049e4756606
                                                              ] ;
                                              rdfs:comment "An object which is a temporal part of another object."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
                                              rdfs:label "SubObject"@en ;
                                              skos:example "If an inhabited house is considered as an house that is occupied by some people in its majority of time, then an interval of inhabited house in which occasionally nobody is in there is no more an inhabited house, but an unhinabited house, since this temporal part does not satisfy the criteria of the whole."@en ;
                                              skos:prefLabel "SubObject"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "An object which is a temporal part of another object."@en ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "Here we consider a temporal interval that is lower than the characteristic time of the physical process that provides the causality connection between the object parts."@en .


