###  https://w3id.org/emmo#EMMO_6786b336_e982_4759_8dee_1905a4106591
ns1:EMMO_6786b336_e982_4759_8dee_1905a4106591 rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf ns1:EMMO_9380ab64_0363_4804_b13f_3a8a94119a76 ;
                                              owl:inverseOf ns1:EMMO_9c2a9899_df4a_4dc7_a28a_ab4dc498db71 ;
                                              rdfs:domain ns1:EMMO_bbca6dfa_7463_4e8d_8280_35862ff50ce0 ;
                                              rdfs:comment "The superproperty of the all object property relations between a whole and its mereological parts of the same type."@en ,
                                                           "RP(x, y) ≡ PP(x, y) ∧ ∃φ(φ(x) ∧ φ(y))" ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/mereocausality#> ;
                                              rdfs:label "hasRedundantPart"@en ;
                                              skos:example "A volume of water has redundand parts other volumes of water. All this volumes have holistic parts some water molecules."@en ;
                                              skos:prefLabel "hasRedundantPart"@en ;
                                              ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 "RP(x, y) ≡ PP(x, y) ∧ ∃φ(φ(x) ∧ φ(y))" ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The superproperty of the all object property relations between a whole and its mereological parts of the same type."@en ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "A part is always distinct xor redundant."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_6786b336_e982_4759_8dee_1905a4106591 ;
   owl:annotatedProperty ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 ;
   owl:annotatedTarget "RP(x, y) ≡ PP(x, y) ∧ ∃φ(φ(x) ∧ φ(y))" ;
   rdfs:seeAlso ns1:EMMO_9380ab64_0363_4804_b13f_3a8a94119a76 ;
   ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "We usa a predicate template notation as RP<φ>(x,y) to specify subclasses of RP(x,y) for the class φ, meaning that RP<φ>(x, y) ≡ PP(x, y) ∧ φ(x) ∧ φ(y)"@en ,
                                                 "φ is a class of the theory that in the EMMO OWL is supposed to be subclass of CausalStructure."@en
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_6786b336_e982_4759_8dee_1905a4106591 ;
   owl:annotatedProperty ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f ;
   owl:annotatedTarget "A part is always distinct xor redundant."@en ;
   rdfs:seeAlso ns1:EMMO_1328d112_e731_4e56_b9b9_6b6cdd495cd6
 ] .


###  https://w3id.org/emmo#EMMO_67fc0a36_8dcb_4ffa_9a43_31074efa3296
ns1:EMMO_67fc0a36_8dcb_4ffa_9a43_31074efa3296 rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf ns1:EMMO_eb3518bf_f799_4f9e_8c3e_ce59af11453b ;
                                              rdf:type owl:InverseFunctionalProperty ,
                                                       owl:AsymmetricProperty ,
                                                       owl:IrreflexiveProperty ;
                                              rdfs:domain ns1:EMMO_0650c031_42b6_4f0a_b62d_d88f071da6bf ;
                                              rdfs:range ns1:EMMO_18ce5200_00f5_45bb_8c6f_6fb128cd41ae ;
                                              rdfs:comment "Relates a quantity to its metrological reference through a semiotic process."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/metrology#> ;
                                              rdfs:label "hasMetrologicalReference"@en ;
                                              owl:versionInfo """In EMMO version 1.0.0, physical quantities used the hasMetrologicalReference object property to relate them to their units via physical dimensionality. This was simplified in 1.0.0-alpha3 in order to make reasoning faster.

The restriction (e.g. for the physical quantity Length)

    Length hasMetrologicalReference only (hasPhysicsDimension only LengthDimension)

was in 1.0.0-alpha3 changed to

    Length hasPhysicsDimension some LengthDimension

Likewise were the universal restrictions on the corresponding unit changed to excistential. E.g.

    Metre hasPhysicsDimension only LengthDimension

was changed to

    Metre hasPhysicsDimension some LengthDimension

The label of this class was also changed from PhysicsDimension to PhysicalDimension.""" ;
                                              skos:prefLabel "hasMetrologicalReference"@en .


