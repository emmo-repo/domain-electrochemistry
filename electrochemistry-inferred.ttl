###  https://w3id.org/emmo#EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d
ns1:EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_53ed8611_2cd7_4286_9ef0_36572117b963 ,
                                                              ns1:EMMO_eb3a768e_d53e_4be9_a23b_0714833c36de ;
                                              rdfs:comment "The class of individuals representing causally self-connected world entities." ,
                                                           "The disjoint union of Causal Path and CausalSystem classes." ,
                                                           """The most fundamental unity criterion for the definition of an structure is that:
- is made of at least two quantums (a structure is not a simple entity)
- all quantum parts form a causally connected graph""" ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/isq#> ;
                                              rdfs:label "CausalStructure"@en ;
                                              skos:prefLabel "CausalStructure"@en ;
                                              ns1:EMMO_31252f35_c767_4b97_a877_1235076c3e13 """The most fundamental unity criterion for the definition of an structure is that:
- is made of at least two quantums (a structure is not a simple entity)
- all quantum parts form a causally connected graph""" ;
                                              ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 "The disjoint union of Causal Path and CausalSystem classes." ;
                                              ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db "EquivalentTo: CausalPath or CausalSystem" ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The class of individuals representing causally self-connected world entities." ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "A causal structure expresses itself in time and space thanks to the underlying causality relations between its constituent quantum entities. It must at least provide two temporal parts. The unity criterion beyond the definition of a causal structure (the most general concept of structure) is the existence of an undirected causal path between each of its parts." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "CausalStructure"@en ;
   ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From Latin causa (“reason, sake, cause”), and from Latin struere (“arrange, assemble, build”)."@en
 ] .


