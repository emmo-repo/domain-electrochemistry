###  https://w3id.org/emmo#AmperePerGram
ns1:AmperePerGram rdf:type owl:Class ;
                  rdfs:subClassOf ns1:EMMO_60b78cc3_6011_4134_95ab_956f56d4bdc1 ,
                                  ns1:EMMO_73be8825_e9a7_41d0_956e_b58060e5d5ac ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                    owl:hasValue "1000.0"^^xsd:double
                                  ] ,
