###  https://w3id.org/emmo/domain/electrochemistry#electrochemistry_fb9bf7cb_dd4b_4391_99a1_628263dd6940
:electrochemistry_fb9bf7cb_dd4b_4391_99a1_628263dd6940 rdf:type owl:Class ;
                                                       rdfs:subClassOf ns1:EMMO_f2d5d3ad_2e00_417f_8849_686f3988d929 ;
                                                       rdfs:comment "measuring instrument to obtain the electrical charge passed in an experiment, or to produce a known amount of substance in a titration."@en ;
                                                       rdfs:isDefinedBy <https://w3id.org/emmo/domain/electrochemistry/modules/electrochemistry-testing#> ;
                                                       rdfs:label "Coulometer"@en ;
                                                       skos:altLabel "Voltameter"@en ;
                                                       skos:prefLabel "Coulometer"@en ;
                                                       ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 "https://www.wikidata.org/wiki/Q905539" ;
                                                       ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "https://dbpedia.org/page/Voltmeter"@en ;
                                                       ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "measuring instrument to obtain the electrical charge passed in an experiment, or to produce a known amount of substance in a titration."@en ;
                                                       ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "Modern instruments for measuring trace water by Karl Fischer titration use the passage of a measured charge to produce iodine from iodide solution. They are known as Karl Fischer coulometers"@en ,
                                                                                                     "The silver coulometer is a primary reference measurement procedure [VIM 2.8] for charge and current. By weighing the mass of silver deposited in a known time at constant current, the charge and current are calculated from Faraday’s laws of electrolysis"@en ;
                                                       ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "https://en.wikipedia.org/wiki/Voltameter"@en .

