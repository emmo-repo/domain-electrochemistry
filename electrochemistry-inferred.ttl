###  https://w3id.org/emmo#MicroFarad
ns1:MicroFarad rdf:type owl:Class ;
               rdfs:subClassOf ns1:EMMO_1e85f9fa_ded6_4856_81be_ccca3c474314 ,
                               ns1:EMMO_9ff3bf8e_2168_406e_8251_1d158fc948ae ,
                               ns1:EMMO_b14d9be5_f81e_469b_abca_379c2e83feab ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty ns1:EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4 ;
                                 owl:someValuesFrom ns1:Farad
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                 owl:hasValue "1.0E-6"^^xsd:double
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                 owl:hasValue "0.0"^^xsd:double
                               ] ;
               rdfs:comment """The \"microfarad\" (symbolized μ F) is a unit of capacitance, equivalent to 0.000001 (10 to the -6th power) farad. The microfarad is a moderate unit of capacitance. In utility alternating-current (AC) and audio-frequency (AF) circuits, capacitors with values on the order of 1 μ F or more are common. At radio frequencies (RF), a smaller unit, the picofarad (pF), is often used.

-- QUDT"""@en ;
               rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/prefixedsiunits#> ;
               rdfs:label "MicroFarad" ;
               skos:altLabel "microfarad"@en ;
               skos:prefLabel "MicroFarad" ;
               ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/MicroFARAD" ;
               ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "uF" ;
               ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "µF" ;
               ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """The \"microfarad\" (symbolized μ F) is a unit of capacitance, equivalent to 0.000001 (10 to the -6th power) farad. The microfarad is a moderate unit of capacitance. In utility alternating-current (AC) and audio-frequency (AF) circuits, capacitors with values on the order of 1 μ F or more are common. At radio frequencies (RF), a smaller unit, the picofarad (pF), is often used.

-- QUDT"""@en .


