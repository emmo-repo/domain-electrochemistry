###  https://w3id.org/emmo#EMMO_506f7823_52bc_40cb_be07_b3b1e10cce13
ns1:EMMO_506f7823_52bc_40cb_be07_b3b1e10cce13 rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_f2ca6dd0_0e5f_4392_a92d_cafdae6cfc95 ,
