###  https://w3id.org/emmo/domain/electrochemistry#electrochemistry_b6319c74_d2ce_48c0_a75a_63156776b302
:electrochemistry_b6319c74_d2ce_48c0_a75a_63156776b302 rdf:type owl:Class ;
                                                       rdfs:subClassOf :electrochemistry_0f007072_a8dd_4798_b865_1bf9363be627 ;
                                                       rdfs:comment "by convention, cell electrode at which an oxidation reaction occurs"@en ;
                                                       rdfs:isDefinedBy <https://w3id.org/emmo/domain/reference/electrochemistry-reference#> ;
                                                       rdfs:label "Anode"@en ;
                                                       skos:note "The anode is the negative electrode during discharge and the positive electrode during charge."@en ;
                                                       skos:prefLabel "Anode"@en ;
                                                       skos:related :electrochemistry_35c650ab_3b23_4938_b312_1b0dede2e6d5 ,
                                                                    :electrochemistry_6f2c88c9_5c04_4953_a298_032cc3ab9b77 ,
                                                                    :electrochemistry_a0580fa9_5073_44af_b33e_7adbc83892d0 ,
                                                                    :electrochemistry_c94c041b_8ea6_43e7_85cc_d2bce7785b4c ;
                                                       ns1:EMMO_0fa6566e_500f_4d24_baa9_b2b22c9a0b72 "The term \"anode\" is often used interchangably with \"negative electrode\" even though it only applies while the cell is being discharged. When the cell is being charged the positive electrode becomes the anode."@en ;
                                                       ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 "https://www.wikidata.org/wiki/Q181232"@en ;
                                                       ns1:EMMO_4c8480cf_56de_41da_8699_f12a9033313a "IEC and IUPAC recommend defining anode/cathode by oxidation/reduction rather than by polarity or charge sign."@en ;
                                                       ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f "https://www.electropedia.org/iev/iev.nsf/display?openform&ievref=482-02-27" ;
                                                       ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "https://dbpedia.org/page/Anode"@en ;
                                                       ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From Greek anodos (‘way up’). Chosen to denote the electrode associated with the ‘upward’ path of current by convention; later anchored by usage to the site of oxidation.Coined by Michael Faraday with guidance from William Whewell and Whitlock Nicholl."@en ;
                                                       ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "by convention, cell electrode at which an oxidation reaction occurs"@en ;
                                                       ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "https://en.wikipedia.org/wiki/Anode"@en ;
                                                       ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://goldbook.iupac.org/terms/view/A00370"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :electrochemistry_b6319c74_d2ce_48c0_a75a_63156776b302 ;
   owl:annotatedProperty skos:note ;
   owl:annotatedTarget "The anode is the negative electrode during discharge and the positive electrode during charge."@en ;
   dcterms:source "International Electrotechnical Commission (IEC), IEC 60050 - International Electrotechnical Vocabulary, retrieved from: https://www.electropedia.org"
 ] .

