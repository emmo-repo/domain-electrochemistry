                                                                                )
                                                                  ] ;
                                              rdfs:subClassOf ns1:EMMO_38b579de_4331_40e0_803d_09efa298e726 ,
                                                              ns1:EMMO_5b2222df_4da6_442f_8244_96e9e45887d1 ,
                                                              ns1:EMMO_b4494d69_6393_4eb4_8346_7fedd4df0bc5 ,
                                                              ns1:EMMO_e04884d9_eda6_487e_93d5_7722d7eda96b ,
                                                              [ rdf:type owl:Restriction ;
