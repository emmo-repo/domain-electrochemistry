###  https://w3id.org/emmo#MilliAmpereHourPerGram
ns1:MilliAmpereHourPerGram rdf:type owl:Class ;
                           rdfs:subClassOf ns1:EMMO_1e85f9fa_ded6_4856_81be_ccca3c474314 ,
                                           ns1:EMMO_4dbe2b16_3e84_4049_898d_eb89bcc925a2 ,
                                           ns1:EMMO_a3a701ed_6f7d_4a10_9aee_dfa1961fc7b7 ,
