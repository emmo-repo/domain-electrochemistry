###  https://w3id.org/emmo#EMMO_0650c031_42b6_4f0a_b62d_d88f071da6bf
ns1:EMMO_0650c031_42b6_4f0a_b62d_d88f071da6bf rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_6f5af708_f825_4feb_a0d1_a8d813d3022b ,
                                                              ns1:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty ns1:EMMO_67fc0a36_8dcb_4ffa_9a43_31074efa3296 ;
                                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onClass ns1:EMMO_18ce5200_00f5_45bb_8c6f_6fb128cd41ae
                                                              ] ;
                                              rdfs:comment "A quantifiable property of a phenomenon, body, or substance."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/domain/reference/electrochemistry-reference#> ;
                                              rdfs:label "Quantity"@en ;
                                              skos:altLabel "Measurand"@en ;
                                              skos:example """length
Rockwell C hardness
electric resistance"""@en ;
                                              skos:prefLabel "Quantity"@en ;
                                              ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "https://qudt.org/schema/qudt/Quantity"^^xsd:anyURI ;
                                              ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db "DisjointUnionOf: SubjectiveProperty, ObjectiveProperty" ,
                                                                                            "EquivalentTo: PhysicalQuantity or OrdinalQuantity" ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A quantifiable property of a phenomenon, body, or substance."@en ;
                                              ns1:EMMO_bb49844b_45d7_4f0d_8cae_8e552cbc20d6 "measurand"@en ,
                                                                                            "quantity"@en ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f """VIM defines a quantity as a \"property of a phenomenon, body, or substance, where the property has a magnitude that can be expressed as a number and a reference\".

A quantity in EMMO is a property and therefore only addresses the first part of the VIM definition (that is a property of a phenomenon, body, or substance). The second part (that it can be expressed as a number and a reference) is syntactic and addressed by emmo:QuantityValue."""@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_0650c031_42b6_4f0a_b62d_d88f071da6bf ;
   owl:annotatedProperty ns1:EMMO_bb49844b_45d7_4f0d_8cae_8e552cbc20d6 ;
   owl:annotatedTarget "measurand"@en ;
   ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "VIM defines measurand as a quantity intended to be measured. This is redundant in EMMO and correspond to Quantity."@en
 ] .


