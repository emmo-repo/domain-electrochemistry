                 ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "lm.W-1" ;
                 ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "lm/W" ;
                 ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """A measurement of luminous efficacy, which is the light output in lumens using one watt of electricity.

-- QUDT"""@en .


###  https://w3id.org/emmo#LumenSecond
ns1:LumenSecond rdf:type owl:Class ;
                rdfs:subClassOf ns1:EMMO_1273eb34_de48_43a9_925f_104110469dd2 ,
                                ns1:EMMO_f6070071_d054_4b17_9d2d_f446f7147d0f ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                  owl:hasValue "1.0"^^xsd:double
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                  owl:hasValue "0.0"^^xsd:double
                                ] ;
                rdfs:comment """In photometry, the lumen second is the SI derived unit of luminous energy. It is based on the lumen, the SI unit of luminous flux, and the second, the SI base unit of time.  The lumen second is sometimes called the talbot (symbol T).  An older name for the lumen second was the lumberg.

-- QUDT"""@en ;
                rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/coherentsiunits#> ,
                                 "http://qudt.org/2.1/vocab/unit" ;
                rdfs:label "LumenSecond"@en ;
                skos:altLabel "lumen second"@en ;
                skos:prefLabel "LumenSecond"@en ;
                ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/LM-SEC" ;
                ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "lm.s" ;
                ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "lm⋅s" ;
                ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """In photometry, the lumen second is the SI derived unit of luminous energy. It is based on the lumen, the SI unit of luminous flux, and the second, the SI base unit of time.  The lumen second is sometimes called the talbot (symbol T).  An older name for the lumen second was the lumberg.

-- QUDT"""@en .


