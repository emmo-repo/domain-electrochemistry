###  https://w3id.org/emmo#EMMO_4f2d1fcc_e20c_4479_9ad7_7a0480dd3e44
ns1:EMMO_4f2d1fcc_e20c_4479_9ad7_7a0480dd3e44 rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_d7788d1a_020d_4c78_85a1_13563fcec168 ;
                                              rdfs:comment "An icon that represents the internal logical structure of the object."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
                                              rdfs:label "AnalogicalIcon"@en ;
                                              skos:example "A physics equation is replicating the mechanisms internal to the object."@en ,
                                                           "Electrical diagram is diagrammatic and resemblance"@en ,
                                                           "MODA and CHADA are diagrammatic representation of a simulation or a characterisation workflow."@en ;
                                              skos:prefLabel "AnalogicalIcon"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "An icon that represents the internal logical structure of the object."@en ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "An icon that focus on HOW the object works."@en ,
                                                                                            "The subclass of icon inspired by Peirceian category (b) the diagram, whose internal relations, mainly dyadic or so taken, represent by analogy (with the same logic) the relations in something (e.g. math formula, geometric flowchart)."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_4f2d1fcc_e20c_4479_9ad7_7a0480dd3e44 ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "AnalogicalIcon"@en ;
   ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From Ancient Greek ἀναλογία (analogía), from ἀνά (aná) + λόγος (lógos, “speech, reckoning”)."@en
 ] .


###  https://w3id.org/emmo#EMMO_4f2d3939_91b1_4001_b8ab_7d19074bf845
ns1:EMMO_4f2d3939_91b1_4001_b8ab_7d19074bf845 rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_194100e1_e11a_4b7c_bb5a_171655679fc8 ,
                                                              ns1:EMMO_2946d40b_24a1_47fa_8176_e3f79bb45064 ,
                                                              ns1:EMMO_af794e9d_dc7d_4756_83e1_2cd0e2ec864e ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty ns1:EMMO_bed1d005_b04e_4a90_94cf_02bc678a8569 ;
                                                                owl:someValuesFrom ns1:EMMO_2e7e5796_4a80_4d73_bb84_f31138446c0c
                                                              ] ;
                                              rdfs:comment "Energy required to move a unit charge through an electric field from a reference point."@en ,
                                                           "The electric potential is not unique, since any constant scalar field quantity can be added to it without changing its gradient."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#> ;
                                              rdfs:label "ElectricPotential"@en ;
                                              skos:altLabel "ElectroStaticPotential"@en ;
                                              skos:prefLabel "ElectricPotential"@en ;
                                              skos:scopeNote "Electric potential is the amount of electric potential energy per unit charge at a specific point in an electric field. In electrochemistry, it helps describe the energy state of an electrode relative to a reference electrode. It is a fundamental concept in electrode reactions, influencing redox potential and determining the driving force behind electrochemical processes. Electric potential is commonly measured in volts (V) and is essential for understanding electrode kinetics, corrosion processes, and electrochemical equilibrium."@en ;
                                              ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/quantitykind/ElectricPotential" ;
                                              ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f "https://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-25" ;
                                              ns1:EMMO_5f7abc2a_5b50_41c3_8def_c8ba7c3b083e "Use a well-defined reference electrode (e.g., Standard Hydrogen Electrode, Ag/AgCl) when measuring electric potential to ensure consistency and comparability."@en ;
                                              ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "https://dbpedia.org/page/Electric_potential" ;
                                              ns1:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 "6-11.1" ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "Energy required to move a unit charge through an electric field from a reference point."@en ;
                                              ns1:EMMO_b6730304_cabc_4104_b415_14218466445c "Electric potential differs from voltage; voltage is the difference in electric potential between two points."@en ;
                                              ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "https://en.wikipedia.org/wiki/Electric_potential" ;
                                              ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://doi.org/10.1351/goldbook.E01935" ;
                                              :electrochemistry_7104c722_d5a5_4bff_ba2f_37e229bb6cce "true"^^xsd:boolean .


###  https://w3id.org/emmo#EMMO_4f40def1_3cd7_4067_9596_541e9a5134cf
