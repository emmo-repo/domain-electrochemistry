###  https://w3id.org/emmo#HertzPerVolt
ns1:HertzPerVolt rdf:type owl:Class ;
                 rdfs:subClassOf ns1:EMMO_1273eb34_de48_43a9_925f_104110469dd2 ,
                                 ns1:EMMO_53b10105_52c7_4746_ab73_a5a30bd198e2 ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                   owl:hasValue "1.0"^^xsd:double
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                   owl:hasValue "0.0"^^xsd:double
                                 ] ;
                 rdfs:comment """In the Hertz per Volt standard the frequency of the note is directly related to the voltage. A pitch of a note goes up one octave when its frequency doubles, meaning that the voltage will have to double for every octave rise. Depending on the footage (octave) selected, nominally one volt gives 1000Hz, two volts 2000Hz and so on. In terms of notes, bottom C would be 0.25 volts, the next C up would be 0.5 volts, then 1V, 2V, 4V, 8V for the following octaves. This system was used mainly by Yamaha and Korg.

-- QUDT"""@en ;
                 rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/coherentsiunits#> ,
                                  "http://qudt.org/2.1/vocab/unit" ;
                 rdfs:label "HertzPerVolt"@en ;
                 skos:altLabel "Hertz per Volt"@en ;
                 skos:prefLabel "HertzPerVolt"@en ;
                 ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/HZ-PER-V" ;
                 ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "Hz.V-1" ;
                 ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "Hz/V" ;
                 ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """In the Hertz per Volt standard the frequency of the note is directly related to the voltage. A pitch of a note goes up one octave when its frequency doubles, meaning that the voltage will have to double for every octave rise. Depending on the footage (octave) selected, nominally one volt gives 1000Hz, two volts 2000Hz and so on. In terms of notes, bottom C would be 0.25 volts, the next C up would be 0.5 volts, then 1V, 2V, 4V, 8V for the following octaves. This system was used mainly by Yamaha and Korg.

-- QUDT"""@en .


###  https://w3id.org/emmo#Hour
ns1:Hour rdf:type owl:Class ;
         rdfs:subClassOf ns1:EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3 ,
                         ns1:EMMO_02e894c3_b793_4197_b120_3442e08f58d1 ,
                         ns1:EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45 ,
                         ns1:EMMO_6795a4b8_ffd0_4588_a581_a9413fe49cac ,
                         ns1:EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                           owl:hasValue "3600.0"^^xsd:double
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                           owl:hasValue "0.0"^^xsd:double
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                           owl:hasValue "h"
                         ] ;
         rdfs:comment "Measure of time defined as 3600 seconds."@en ,
                      """The hour (common symbol: h or hr) is a unit of measurement of time. In modern usage, an hour comprises 60 minutes, or 3,600 seconds. It is approximately 1/24 of a mean solar day. An hour in the Universal Coordinated Time (UTC) time standard can include a negative or positive leap second, and may therefore have a duration of 3,599 or 3,601 seconds for adjustment purposes. Although it is not a standard defined by the International System of Units, the hour is a unit accepted for use with SI, represented by the symbol h.

-- QUDT"""@en ;
         rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siacceptedspecialunits#> ;
         rdfs:label "Hour"@en ;
         skos:prefLabel "Hour"@en ;
         schema:unitCode "HUR" ;
         ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/HR" ;
         ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "h" ;
         ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 "Measure of time defined as 3600 seconds."@en ;
         ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """The hour (common symbol: h or hr) is a unit of measurement of time. In modern usage, an hour comprises 60 minutes, or 3,600 seconds. It is approximately 1/24 of a mean solar day. An hour in the Universal Coordinated Time (UTC) time standard can include a negative or positive leap second, and may therefore have a duration of 3,599 or 3,601 seconds for adjustment purposes. Although it is not a standard defined by the International System of Units, the hour is a unit accepted for use with SI, represented by the symbol h.

-- QUDT"""@en ;
         ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://doi.org/10.1351/goldbook.H02866" .


###  https://w3id.org/emmo#Joule
ns1:Joule rdf:type owl:Class ;
          rdfs:subClassOf ns1:EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3 ,
                          ns1:EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45 ,
                          ns1:EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a ,
                          ns1:EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b ,
                          ns1:EMMO_f6070071_d054_4b17_9d2d_f446f7147d0f ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                            owl:hasValue "J"
                          ] ;
          rdfs:comment "SI unit for energy."@en ;
          rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits#> ;
          rdfs:label "Joule"@en ;
          skos:prefLabel "Joule"@en ;
          schema:unitCode "JOU" ;
          ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/J" ;
          ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "J" ;
          ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "http://dbpedia.org/resource/Joule"^^xsd:anyURI ;
          ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "SI unit for energy."@en ;
          ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f """The SI unit of work or energy, defined to be the work done by a force of one newton acting to move an object through a distance of one meter in the direction in which the force is applied. Equivalently, since kinetic energy is one half the mass times the square of the velocity, one joule is the kinetic energy of a mass of two kilograms moving at a velocity of 1 m/s.

-- QUDT"""@en ;
          ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Joule?oldid=494340406"^^xsd:anyURI ;
          ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://doi.org/10.1351/goldbook.J03363" .


