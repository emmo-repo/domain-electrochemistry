                                              rdfs:subPropertyOf ns1:EMMO_b85e4738_500c_4e1b_bbe8_9e84190485d6 ,
                                                                 ns1:EMMO_ebc9e62c_5dc4_44db_9060_7923740bdf78 ;
                                              owl:inverseOf ns1:EMMO_451e410e_8e0d_4a4b_9211_d6ef619296dc ;
                                              rdf:type owl:AsymmetricProperty ,
                                                       owl:IrreflexiveProperty ;
                                              owl:propertyDisjointWith ns1:EMMO_d01b3ee2_91a5_4ce2_95cd_f0d2c333c6d3 ;
                                              rdfs:comment "A causal relation between the y effected and the x causing entities with intermediaries, where x isCauseOf y and not(y isCauseOf x)."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/mereocausality#> ;
                                              rdfs:label "foreruns"@en ;
                                              rdfs:seeAlso ns1:EMMO_451e410e_8e0d_4a4b_9211_d6ef619296dc ;
                                              skos:altLabel "hasSuccessor"@en ,
                                                            "isAntecedentOf"@en ,
                                                            "predecessorOf"@en ;
                                              skos:example "My life between 18-24 years has successor my life between 32-40 years, since there is an intermediary (i.e. my life between 25-32 years)."@en ;
                                              skos:prefLabel "foreruns"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A causal relation between the y effected and the x causing entities with intermediaries, where x isCauseOf y and not(y isCauseOf x)."@en ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "Transitivity is implemented at A-Box level with a SWRL rule."@en .

