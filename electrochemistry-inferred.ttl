###  https://w3id.org/emmo#EMMO_cbcf8fe6_6da6_49e0_ab4d_00f737ea9689
ns1:EMMO_cbcf8fe6_6da6_49e0_ab4d_00f737ea9689 rdf:type owl:Class ;
                                              owl:equivalentClass [ rdf:type owl:Class ;
                                                                    owl:unionOf ( ns1:EMMO_4f40def1_3cd7_4067_9596_541e9a5134cf
                                                                                  ns1:EMMO_643d99dd_fae6_4121_a76f_47f486a4480b
