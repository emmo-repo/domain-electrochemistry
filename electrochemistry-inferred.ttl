                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                 owl:hasValue "1.0E-9"^^xsd:double
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                 owl:hasValue "0.0"^^xsd:double
                               ] ;
               rdfs:comment """A nanosecond is a SI unit of time equal to one billionth of a second (10-9 or 1/1,000,000,000 s). One nanosecond is to one second as one second is to 31.69 years. The word nanosecond is formed by the prefix nano and the unit second.

-- QUDT"""@en ;
               rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/prefixedsiunits#> ;
               rdfs:label "NanoSecond" ;
               skos:altLabel "nanosecond"@en ;
               skos:prefLabel "NanoSecond" ;
               ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/NanoSEC" ;
               ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "ns" ;
               ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "ns" ;
               ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """A nanosecond is a SI unit of time equal to one billionth of a second (10-9 or 1/1,000,000,000 s). One nanosecond is to one second as one second is to 31.69 years. The word nanosecond is formed by the prefix nano and the unit second.

-- QUDT"""@en ;
               ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Nanosecond?oldid=919778950" .


