###  https://w3id.org/emmo/domain/electrochemistry#electrochemistry_639b844a_e801_436b_985d_28926129ead6
:electrochemistry_639b844a_e801_436b_985d_28926129ead6 rdf:type owl:Class ;
                                                       rdfs:subClassOf ns1:EMMO_17b031fb_4695_49b6_bb69_189ec63df3ee ;
                                                       rdfs:comment "suitable approximate value of the voltage used to designate or identify a cell, a battery or an electrochemical system"@en ;
                                                       rdfs:isDefinedBy <https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#> ;
                                                       rdfs:label "NominalVoltage"@en ;
                                                       skos:prefLabel "NominalVoltage"@en ;
                                                       skos:scopeNote "Nominal voltage is the standardized voltage value assigned to a battery cell or module based on typical operating conditions. It serves as a reference point for battery specifications but does not represent the actual voltage during operation. Actual cell voltage may vary due to factors such as state-of-charge, temperature, and load conditions."@en ;
                                                       ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f "https://www.electropedia.org/iev/iev.nsf/display?openform&ievref=482-03-31"@en ;
                                                       ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "suitable approximate value of the voltage used to designate or identify a cell, a battery or an electrochemical system"@en ;
                                                       ns1:EMMO_b6730304_cabc_4104_b415_14218466445c "Nominal voltage may not accurately reflect voltage under extreme loads or temperatures—always check manufacturer specifications."@en .

