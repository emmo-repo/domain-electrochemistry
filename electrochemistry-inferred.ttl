###  https://w3id.org/emmo/domain/electrochemistry#electrochemistry_d48ea516_5cac_4f86_bc88_21b6276c0938
:electrochemistry_d48ea516_5cac_4f86_bc88_21b6276c0938 rdf:type owl:Class ;
                                                       rdfs:subClassOf :electrochemistry_3d805c2a_4801_440e_9e4d_0fa5585c76ae ;
                                                       rdfs:comment "a phenomenological model for electrode kinetics, describing the relation between the electrode current from an electrochemical charge-transfer reaction and the surface overpotential of the electrode"@en ;
                                                       rdfs:isDefinedBy <https://w3id.org/emmo/domain/reference/electrochemistry-reference#> ;
                                                       rdfs:label "ButlerVolmerEquation"@en ;
                                                       skos:altLabel "ButlerVolmerApproximation"@en ,
                                                                     "ErdeyGruzVolmerEquation"@en ;
                                                       skos:prefLabel "ButlerVolmerEquation"@en ;
                                                       ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 "https://www.wikidata.org/wiki/Q903846" ;
                                                       ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "https://dbpedia.org/page/Butler%E2%80%93Volmer_equation"@en ;
                                                       ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "a phenomenological model for electrode kinetics, describing the relation between the electrode current from an electrochemical charge-transfer reaction and the surface overpotential of the electrode"@en ;
                                                       ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "i = i0 * (exp(alpha*n*F*eta/(R*T)) – exp(-(1-alpha)*n*F*eta/(R*T)))" ;
                                                       ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "https://en.wikipedia.org/wiki/Butler%E2%80%93Volmer_equation"@en .


