###  https://w3id.org/emmo#EMMO_49267eba_5548_4163_8f36_518d65b583f9
ns1:EMMO_49267eba_5548_4163_8f36_518d65b583f9 rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_c5ddfdba_c074_4aa4_ad6b_1ac4942d300d ;
                                              rdfs:comment "The class of causal objects that stand for world objects according to a specific representational perspective."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/isq#> ;
                                              rdfs:label "Perspective"@en ;
                                              skos:prefLabel "Perspective"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The class of causal objects that stand for world objects according to a specific representational perspective."@en ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f """This class is the practical implementation of the EMMO pluralistic approach for which the only objective categorization is provided by the Universe individual and all the Quantum individuals.
Between these two extremes, there are several subjective ways to categorize real world objects, each one provide under a 'Perspective' subclass."""@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_49267eba_5548_4163_8f36_518d65b583f9 ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "Perspective"@en ;
   ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From medieval Latin perspectiva ‘(science of) optics’, from perspect- ‘looked at closely’, from the verb perspicere, from per- ‘through’ + specere ‘to look’."@en
 ] .


###  https://w3id.org/emmo#EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8
ns1:EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8 rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_86ca9b93_1183_4b65_81b8_c0fcd3bba5ad ;
                                              rdfs:comment "An object which is instrumental for reaching a particular purpose through its characteristic functioning process, with particular reference to mechanical or electronic equipment."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/domain/reference/electrochemistry-reference#> ;
                                              rdfs:label "Device"@en ;
                                              skos:altLabel "Equipment"@en ,
                                                            "Machine"@en ;
                                              skos:prefLabel "Device"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "An object which is instrumental for reaching a particular purpose through its characteristic functioning process, with particular reference to mechanical or electronic equipment."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8 ;
   owl:annotatedProperty skos:altLabel ;
   owl:annotatedTarget "Equipment"@en ;
   ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From French équipement, from équiper ‘equip’."@en
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8 ;
   owl:annotatedProperty skos:altLabel ;
   owl:annotatedTarget "Machine"@en ;
   ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From Latin māchina (“a machine, engine, contrivance, device, stratagem, trick”), from Doric Greek μᾱχᾰνᾱ́ (mākhanā́), cognate with Attic Greek μηχᾰνή (mēkhanḗ, “a machine, engine, contrivance, device”), from which comes mechanical."@en
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8 ;
   owl:annotatedProperty skos:prefLabel ;
   owl:annotatedTarget "Device"@en ;
   ns1:EMMO_705f27ae_954c_4f13_98aa_18473fc52b25 "From Old French \"deviser\", meaning: arrange, plan, contrive. Literally \"dispose in portions,\" from Vulgar Latin \"divisare\", frequentative of Latin dividere, meaning \"to divide\"."@en
 ] .


###  https://w3id.org/emmo#EMMO_49804605_c0fe_4538_abda_f70ba1dc8a5d
ns1:EMMO_49804605_c0fe_4538_abda_f70ba1dc8a5d rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_846b637b_7b12_47a1_9430_0274b2f588ac ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty [ owl:inverseOf ns1:EMMO_d43af210_f854_4432_a891_ce3022e3b558
                                                                               ] ;
                                                                owl:someValuesFrom ns1:EMMO_43e9a05d_98af_41b4_92f6_00f79a09bfce
                                                              ] ;
                                              rdfs:comment "A process which is a spatial part of another process."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/persistence#> ;
                                              rdfs:label "SubProcess"@en ;
                                              skos:example "Breathing is a subprocess of living for a human being."@en ;
                                              skos:prefLabel "SubProcess"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A process which is a spatial part of another process."@en ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f """In the EMMO the relation of participation to a process falls under mereotopology.

Since topological connection means causality, then the only way for a real world object to participate to a process is to be a part of it."""@en .


