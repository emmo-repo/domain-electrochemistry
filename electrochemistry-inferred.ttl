###  https://w3id.org/emmo/domain/electrochemistry#electrochemistry_9b3b4668_0795_4a35_9965_2af383497a26
:electrochemistry_9b3b4668_0795_4a35_9965_2af383497a26 rdf:type owl:Class ;
                                                       rdfs:subClassOf :electrochemistry_791c1915_a791_4450_acd8_7f94764743b5 ;
                                                       rdfs:comment "capacity value of a battery [or electrode or electrochemical device] determined under specified conditions and declared by the manufacturer"@en ;
                                                       rdfs:isDefinedBy <https://w3id.org/emmo/domain/electrochemistry/reference/electrochemistry-quantities#> ;
                                                       rdfs:label "RatedCapacity"@en ;
                                                       rdfs:seeAlso "https://w3id.org/emmo/domain/electrochemistry#electrochemistry_5ebeea80_af22_456b_9087_78c2a8465c58" ,
                                                                    "https://w3id.org/emmo/domain/electrochemistry#electrochemistry_e1fd84eb_acdb_4b2c_b90c_e899d552a3ee" ;
                                                       skos:prefLabel "RatedCapacity"@en ;
                                                       skos:scopeNote "The term 'rated capacity' is used by manufacturers to specify the energy storage capability of a product under some controlled test conditions. The value is often determined during a constant current load until the a voltage limit is reached, under controlled temperature conditions. The 'rated capacity' helps to compare performance across different devices and provides a bisis for performing system engineering calculations. It can also be used as a basis for calculating other terms like the C-Rate, state-of-charge, and state-of-health of the device. The rated capacity at beginning of life serves as a reference for capacity-fade analysis during long-term cycling."@en ;
                                                       ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f "https://www.electropedia.org/iev/iev.nsf/display?openform&ievref=482-03-15"@en ;
                                                       ns1:EMMO_5f7abc2a_5b50_41c3_8def_c8ba7c3b083e "The value of rated capacity should be reported together with information on the conditions under which it was determined (e.g. voltage limits, applied current, temperature)."@en ;
                                                       ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "capacity value of a battery [or electrode or electrochemical device] determined under specified conditions and declared by the manufacturer"@en ;
                                                       ns1:EMMO_b6730304_cabc_4104_b415_14218466445c "The value for rated capacity does not necessarily represent the actual capacity in real-world usage, as factors like temperature, rate, and state-of-health affect the effective capacity."@en ;
                                                       ns1:EMMO_cc65321f_1964_4f16_aea3_2a8edf2f3394 "https://w3id.org/emmo#AmpereHour"^^xsd:anyURI ,
                                                                                                     "https://w3id.org/emmo#MilliAmpereHour" .

