                                              rdfs:subClassOf ns1:EMMO_59e710f4_d9ea_4167_9a3f_f90628a307df ,
                                                              ns1:EMMO_707c6032_e272_4a20_98b5_d35c4f67be68 ;
                                              rdfs:comment "A SI derived unit whos numerical factor in front of the product of SI base units is one."@en ,
