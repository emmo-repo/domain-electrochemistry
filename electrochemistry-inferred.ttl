###  https://w3id.org/emmo#EMMO_55375713_8f92_473b_a688_b7fcc14f7797
ns1:EMMO_55375713_8f92_473b_a688_b7fcc14f7797 rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf ns1:EMMO_82a96de2_41aa_4bf7_b7ac_de1373d50160 ;
                                              owl:inverseOf ns1:EMMO_eb3518bf_f799_4f9e_8c3e_ce59af11453b ;
