###  https://w3id.org/emmo#Dalton
ns1:Dalton rdf:type owl:Class ;
           rdfs:subClassOf ns1:EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3 ,
                           ns1:EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45 ,
                           ns1:EMMO_6795a4b8_ffd0_4588_a581_a9413fe49cac ,
                           ns1:EMMO_77e9dc31_5b19_463e_b000_44c6e79f98aa ,
                           ns1:EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                             owl:hasValue "1.660539E-27"^^xsd:double
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                             owl:hasValue "0.0"^^xsd:double
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                             owl:hasValue "Da"
                           ] ;
           rdfs:comment "One dalton is defined as one twelfth of the mass of an unbound neutral atom of carbon-12 in its nuclear and electronic ground state."@en ,
                        """The unified atomic mass unit (symbol: μ) or dalton (symbol: Da) is a unit that is used for indicating mass on an atomic or molecular scale. It is defined as one twelfth of the rest mass of an unbound atom of carbon-12 in its nuclear and electronic ground state, and has a value of 1.660538782(83) × 10⁻²⁷ kg. One Da is approximately equal to the mass of one proton or one neutron. The CIPM have categorised it as a \"non-SI unit whose values in SI units must be obtained experimentally\".

-- QUDT"""@en ;
           rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siacceptedspecialunits#> ,
                            "http://qudt.org/2.1/vocab/unit" ;
           rdfs:label "Dalton"@en ;
           skos:altLabel "AtomicMassUnit"@en ;
           skos:prefLabel "Dalton"@en ;
           schema:unitCode "D43" ;
           ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/Da"^^xsd:anyURI ;
           ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "u" ;
           ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "http://dbpedia.org/page/Unified_atomic_mass_unit" ;
           ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 "One dalton is defined as one twelfth of the mass of an unbound neutral atom of carbon-12 in its nuclear and electronic ground state."@en ;
           ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "amu" ;
           ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """The unified atomic mass unit (symbol: μ) or dalton (symbol: Da) is a unit that is used for indicating mass on an atomic or molecular scale. It is defined as one twelfth of the rest mass of an unbound atom of carbon-12 in its nuclear and electronic ground state, and has a value of 1.660538782(83) × 10⁻²⁷ kg. One Da is approximately equal to the mass of one proton or one neutron. The CIPM have categorised it as a \"non-SI unit whose values in SI units must be obtained experimentally\".

-- QUDT"""@en ;
           ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Atomic_mass_unit"^^xsd:anyURI ;
           ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://doi.org/10.1351/goldbook.D01514" .


