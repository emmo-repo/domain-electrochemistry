                                              ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 "The disjoint union of the CausalSystem and Collection classes."@en ;
                                              ns1:EMMO_8a137e9f_579c_4e28_baca_e8980eb0c3db "EquivalentTo: Collection or CausalSystem" ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The class of individuals representing causal clusters."@en .

