                         [ rdf:type owl:Restriction ;
                           owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                           owl:hasValue "Gy"
                         ] ;
         rdfs:comment "SI unit for absorbed dose."@en ;
         rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits#> ;
         rdfs:label "Gray"@en ;
         skos:prefLabel "Gray"@en ;
         schema:unitCode "A95" ;
         ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/GRAY" ;
         ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "Gy" ;
         ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "http://dbpedia.org/resource/Grey"^^xsd:anyURI ;
         ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "SI unit for absorbed dose."@en ;
         ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f """The SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray (1905-1965), an authority on the use of radiation in the treatment of cancer.

-- QUDT""" ;
         ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "//en.wikipedia.org/wiki/Grey?oldid=494774160"^^xsd:anyURI ;
         ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://doi.org/10.1351/goldbook.G02696" .


