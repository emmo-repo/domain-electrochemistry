###  https://w3id.org/emmo#Becquerel
ns1:Becquerel rdf:type owl:Class ;
              rdfs:subClassOf ns1:EMMO_0266ec8c_bd13_4c9c_be77_607498793ed3 ,
                              ns1:EMMO_1abe0ea7_2378_402f_b950_89b0795d2f45 ,
                              ns1:EMMO_515b5579_d526_4842_9e6f_ecc34db6f368 ,
                              ns1:EMMO_9e5f464a_658c_4b34_b80d_a5f8d5ec811a ,
                              ns1:EMMO_e9ffc696_5228_4ff9_8a60_0f5e05e9931b ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ns1:EMMO_daf7a9b7_18ef_4e73_9fb9_75adfd9800e8 ;
                                owl:hasValue "Bq"
                              ] ;
              rdfs:comment "Radioactive decays per second."@en ,
                           "SI unit for radioactive activity."@en ;
              rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/siunits#> ;
              rdfs:label "Becquerel"@en ;
              skos:prefLabel "Becquerel"@en ;
              schema:unitCode "BQL" ;
              ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/BQ" ;
              ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "Bq" ;
              ns1:EMMO_6dd685dd_1895_46e4_b227_be9f7d643c25 "http://dbpedia.org/resource/Becquerel"^^xsd:anyURI ;
              ns1:EMMO_70fe84ff_99b6_4206_a9fc_9a8931836d84 "Radioactive decays per second."@en ;
              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "SI unit for radioactive activity."@en ;
              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f """The SI derived unit of activity, usually meaning radioactivity. \"Radioactivity\" is caused when atoms disintegrate, ejecting energetic particles. One becquerel is the radiation caused by one disintegration per second; this is equivalent to about 27.0270 picocuries (pCi). The unit is named for a French physicist, Antoine-Henri Becquerel (1852-1908), the discoverer of radioactivity. Note: both the becquerel and the hertz are basically defined as one event per second, yet they measure different things. The hertz is used to measure the rates of events that happen periodically in a fixed and definite cycle. The becquerel is used to measure the rates of events that happen sporadically and unpredictably, not in a definite cycle.

-- QUDT"""@en ;
              ns1:EMMO_c84c6752_6d64_48cc_9500_e54a3c34898d "http://en.wikipedia.org/wiki/Becquerel?oldid=493710036"^^xsd:anyURI ;
              ns1:EMMO_fe015383_afb3_44a6_ae86_043628697aa2 "https://doi.org/10.1351/goldbook.B00624" .


