###  https://w3id.org/emmo#MicroMolePerSquareMetrePerSecond
ns1:MicroMolePerSquareMetrePerSecond rdf:type owl:Class ;
                                     rdfs:subClassOf ns1:EMMO_1e85f9fa_ded6_4856_81be_ccca3c474314 ,
                                                     ns1:EMMO_9ff3bf8e_2168_406e_8251_1d158fc948ae ,
                                                     ns1:EMMO_a94aec97_71ff_4574_b111_a52d77d2c230 ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty ns1:EMMO_d4e0a0ab_2f67_4f87_a0db_b544e6dceed4 ;
                                                       owl:someValuesFrom ns1:MolePerSquareMetrePerSecond
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty ns1:EMMO_8189b42e_0995_423a_a26c_51168b27c3cf ;
                                                       owl:hasValue "1.0E-6"^^xsd:double
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty ns1:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ;
                                                       owl:hasValue "0.0"^^xsd:double
                                                     ] ;
                                     rdfs:comment """One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area per SI unit of time.  This term is based on the number of photons in a certain waveband incident per unit time (s) on a unit area (m2) divided by the Avogadro constant (6.022 x 1023 mol-1). It is used commonly to describe PAR in the 400-700 nm waveband. Definition Source: Thimijan, Richard W., and Royal D. Heins. 1982. Photometric, Radiometric, and Quantum Light Units of Measure: A Review of Procedures for Interconversion. HortScience 18:818-822.

-- QUDT"""@en ;
                                     rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/units/noncoherentsiunits#> ;
                                     rdfs:label "MicroMolePerSquareMetrePerSecond" ;
                                     skos:altLabel "Micromoles per square metre per second"@en ;
                                     skos:prefLabel "MicroMolePerSquareMetrePerSecond" ;
                                     ns1:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/MicroMOL-PER-M2-SEC" ;
                                     ns1:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "umol.m-2.s-1" ,
                                                                                   "umol/m2/s" ;
                                     ns1:EMMO_7f1dec83_d85e_4e1b_b7bd_c9442d4f5a64 "µmol/(m²⋅s)" ;
                                     ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area per SI unit of time.  This term is based on the number of photons in a certain waveband incident per unit time (s) on a unit area (m2) divided by the Avogadro constant (6.022 x 1023 mol-1). It is used commonly to describe PAR in the 400-700 nm waveband. Definition Source: Thimijan, Richard W., and Royal D. Heins. 1982. Photometric, Radiometric, and Quantum Light Units of Measure: A Review of Procedures for Interconversion. HortScience 18:818-822.

-- QUDT"""@en .


