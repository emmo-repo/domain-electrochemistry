###  https://w3id.org/emmo#EMMO_fc859d37_408d_44b6_b345_a0ea0b65121e
ns1:EMMO_fc859d37_408d_44b6_b345_a0ea0b65121e rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_71d1c8f0_c6e3_44b5_a4b6_1b74ff35698a ,
                                                              ns1:EMMO_a4d66059_5dd3_4b90_b4cb_10960559441b ;
                                              rdfs:comment "The processing of a material aimed to transform its structure by means of any type of treatment, without involving relevant synthesis phenomena."@en ,
                                                           "esce workpiece" ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/disciplines/manufacturing#> ;
                                              rdfs:label "MaterialTreatment"@en ;
                                              rdfs:seeAlso "DIN 8580:2020"@en ;
                                              skos:altLabel "Stoffeigenschaft ändern" ,
                                                            "WorkPieceTreatment" ;
                                              skos:prefLabel "MaterialTreatment"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The processing of a material aimed to transform its structure by means of any type of treatment, without involving relevant synthesis phenomena."@en ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "Has shaped bodies as input and output."@en ,
                                                                                            "Manufacturing by changing the properties of the material of which a workpiece is made, which is done, among other things, by changes in the submicroscopic or atomic range, e.g. by diffusion of atoms, generation and movement of dislocations in the atomic lattice or chemical reactions, and where unavoidable changes in shape are not part of the essence of these processes." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource ns1:EMMO_fc859d37_408d_44b6_b345_a0ea0b65121e ;
