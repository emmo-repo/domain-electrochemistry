###  https://w3id.org/emmo#Kilogram
ns1:Kilogram rdf:type owl:Class ;
             rdfs:subClassOf ns1:EMMO_3a185e6c_9e19_4776_b583_19c978156aa0 ,
                             ns1:EMMO_77e9dc31_5b19_463e_b000_44c6e79f98aa ,
