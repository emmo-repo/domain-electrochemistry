                                                       rdfs:label "ParasiticReaction"@en ;
                                                       skos:prefLabel "ParasiticReaction"@en ;
                                                       skos:scopeNote "Parasitic reactions are a subset of side reactions specifically associated with unwanted charge transfer."@en ;
                                                       ns1:EMMO_50c298c2_55a2_4068_b3ac_4e948c33181f "https://www.electropedia.org/iev/iev.nsf/display?openform&ievref=114-02-07" ,
