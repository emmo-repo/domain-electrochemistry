###  https://w3id.org/emmo#NewtonPerSquareMetre
ns1:NewtonPerSquareMetre rdf:type owl:Class ;
                         rdfs:subClassOf ns1:EMMO_1273eb34_de48_43a9_925f_104110469dd2 ,
