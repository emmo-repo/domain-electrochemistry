                                                                               rdfs:label "Voltammetry"@en ;
                                                                               skos:prefLabel "Voltammetry"@en ;
                                                                               ns1:EMMO_26bf1bef_d192_4da6_b0eb_d2209698fb54 "https://www.wikidata.org/wiki/Q904093" ;
