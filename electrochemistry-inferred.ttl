###  https://w3id.org/emmo#EMMO_6f5af708_f825_4feb_a0d1_a8d813d3022b
ns1:EMMO_6f5af708_f825_4feb_a0d1_a8d813d3022b rdf:type owl:Class ;
                                              rdfs:subClassOf ns1:EMMO_b803f122_4acb_4064_9d71_c1e5fd091fc9 ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty [ owl:inverseOf ns1:EMMO_27e8e2dd_78a5_433a_b522_a1f61a08aab4
                                                                               ] ;
                                                                owl:someValuesFrom ns1:EMMO_054af807_85cd_4a13_8eba_119dfdaaf38b
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty [ owl:inverseOf ns1:EMMO_8fb6d667_f2af_482d_97a9_ec97cd81274d
                                                                               ] ;
                                                                owl:someValuesFrom ns1:EMMO_008fd3b2_4013_451f_8827_52bceab11841
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty [ owl:inverseOf ns1:EMMO_f2fc1ce9_cc3b_4eb5_a112_3c85d1b1374a
                                                                               ] ;
                                                                owl:someValuesFrom ns1:EMMO_0527413c_b286_4e9c_b2d0_03fb2a038dee
                                                              ] ;
                                              rdfs:comment "The object, in Peirce semiotics, as participant to a semiotic process."@en ;
                                              rdfs:isDefinedBy <https://w3id.org/emmo/perspectives/semiotics#> ;
                                              rdfs:label "Referent"@en ;
                                              skos:altLabel "Object"@en ,
                                                            "SemioticObject"@en ;
                                              skos:prefLabel "Referent"@en ;
                                              ns1:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The object, in Peirce semiotics, as participant to a semiotic process."@en ;
                                              ns1:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f """Here is assumed that the concept of 'object' is always relative to a 'semiotic' process. An 'object' does not exists per se, but it's always part of an interpretation.

The EMMO relies on strong reductionism, i.e. everything real is a formless collection of elementary particles: we give a meaning to real world entities only by giving them boundaries and defining them using 'sign'-s.

In this way the 'sign'-ed entity becomes an 'object', and the 'object' is the basic entity needed in order to apply a logical formalism to the real world entities (i.e. we can speak of it through its sign, and use logics on it through its sign)."""@en .


